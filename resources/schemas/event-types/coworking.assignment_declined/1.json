{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/event-types/coworking.assignment_declined/1.json",
    "title": "coworking.assignment_declined v1",
    "description": "Lo studio rifiuta l'incarico offerto, con l'istante della risposta e un motivo facoltativo. Il committente registra la transazione declined con responded_at uguale a answered_at.",
    "type": "object",
    "properties": {
        "transaction": {
            "description": "La transazione dell'affidamento, registrata dal committente.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                }
            },
            "required": [
                "id"
            ],
            "additionalProperties": false
        },
        "answered_at": {
            "description": "L'istante della risposta nel sistema dello studio.",
            "$ref": "#/$defs/datetime"
        },
        "reason": {
            "description": "Il motivo del rifiuto, per il committente, oppure null.",
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "maxLength": 1000
        }
    },
    "required": [
        "transaction",
        "answered_at",
        "reason"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "datetime": {
            "type": "string",
            "format": "date-time"
        },
        "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "province": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        }
    }
}
