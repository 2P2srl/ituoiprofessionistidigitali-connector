{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/event-types/transaction.counterparty_selected/1.json",
    "title": "transaction.counterparty_selected v1",
    "description": "La scelta della controparte di un incarico pubblicato: la transazione accettata, la candidatura scelta e, per una persona, il cellulare. La manda solo il portale, al sistema del committente, anche quando la scelta l'ha fatta lui.",
    "type": "object",
    "properties": {
        "transaction": {
            "description": "La transazione accettata, nella forma di GET /transactions. Il portale può aggiungere campi alla transazione senza cambiare versione.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "origin": {
                    "const": "platform"
                },
                "reference": {
                    "$ref": "#/$defs/reference"
                },
                "assignment_reference": {
                    "$ref": "#/$defs/reference"
                },
                "audience": {
                    "enum": [
                        "person",
                        "member",
                        "any"
                    ]
                },
                "principal": {
                    "$ref": "#/$defs/uuid"
                },
                "counterparty": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/person"
                        },
                        {
                            "$ref": "#/$defs/member"
                        }
                    ]
                },
                "typology": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                },
                "status": {
                    "const": "accepted"
                },
                "sent_at": {
                    "$ref": "#/$defs/datetime"
                },
                "expires_at": {
                    "$ref": "#/$defs/datetime"
                },
                "responded_at": {
                    "$ref": "#/$defs/datetime"
                },
                "signed_at": {
                    "type": "null"
                },
                "closed_at": {
                    "type": "null"
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "total_cents": {
                    "type": "integer",
                    "minimum": 0
                },
                "revision": {
                    "type": "integer",
                    "minimum": 2
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "schema_version": {
                    "type": "integer",
                    "minimum": 1
                },
                "activities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                        "type": "object",
                        "required": [
                            "reference",
                            "compensation",
                            "estimated_minutes",
                            "minutes_worked",
                            "status",
                            "closed_at",
                            "total_cents",
                            "description"
                        ]
                    }
                },
                "updated_at": {
                    "$ref": "#/$defs/datetime"
                }
            },
            "required": [
                "id",
                "origin",
                "reference",
                "assignment_reference",
                "audience",
                "principal",
                "counterparty",
                "typology",
                "title",
                "description",
                "status",
                "sent_at",
                "expires_at",
                "responded_at",
                "signed_at",
                "closed_at",
                "currency",
                "total_cents",
                "revision",
                "type",
                "schema_version",
                "activities",
                "updated_at"
            ]
        },
        "application": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "status": {
                    "const": "selected"
                },
                "applied_at": {
                    "$ref": "#/$defs/datetime"
                },
                "terms_accepted_at": {
                    "description": "Il consenso di chi si candida alle condizioni dell'incarico.",
                    "$ref": "#/$defs/datetime"
                },
                "accepted_revision": {
                    "description": "La revisione della transazione di cui chi si candida ha accettato le condizioni.",
                    "type": "integer",
                    "minimum": 1
                },
                "closed_at": {
                    "$ref": "#/$defs/datetime"
                },
                "applicant": {
                    "$ref": "#/$defs/applicant"
                }
            },
            "required": [
                "id",
                "status",
                "applied_at",
                "terms_accepted_at",
                "accepted_revision",
                "closed_at",
                "applicant"
            ],
            "additionalProperties": false
        },
        "contact": {
            "description": "I recapiti della persona scelta che non fanno parte della controparte; null per uno studio, che si scambia i dati con coworking.contract_details.",
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "mobile": {
                            "description": "Il cellulare, in formato E.164.",
                            "type": "string",
                            "pattern": "^\\+[1-9][0-9]{6,14}$"
                        }
                    },
                    "required": [
                        "mobile"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "transaction",
        "application",
        "contact"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "datetime": {
            "type": "string",
            "format": "date-time"
        },
        "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "province": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        },
        "applicant": {
            "description": "Il candidato: un professionista o uno studio.",
            "oneOf": [
                {
                    "$ref": "#/$defs/person_applicant"
                },
                {
                    "$ref": "#/$defs/member_applicant"
                }
            ]
        },
        "person": {
            "description": "La controparte persona, con l'anagrafica del professionista al momento della scelta. Il sistema la rimanda identica a ogni revisione.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "person"
                },
                "member_id": {
                    "type": "null"
                },
                "tax_code": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{16}$"
                },
                "first_name": {
                    "$ref": "#/$defs/name"
                },
                "last_name": {
                    "$ref": "#/$defs/name"
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                },
                "vat_number": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9]{11}$"
                },
                "municipality": {
                    "$ref": "#/$defs/name"
                },
                "province": {
                    "$ref": "#/$defs/province"
                }
            },
            "required": [
                "type",
                "member_id",
                "tax_code",
                "first_name",
                "last_name",
                "email",
                "vat_number",
                "municipality",
                "province"
            ],
            "additionalProperties": false
        },
        "person_applicant": {
            "description": "Il professionista candidato, senza codice fiscale, email, partita IVA e cellulare, che arrivano solo con la scelta.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "person"
                },
                "first_name": {
                    "$ref": "#/$defs/name"
                },
                "last_name": {
                    "$ref": "#/$defs/name"
                },
                "municipality": {
                    "$ref": "#/$defs/name"
                },
                "province": {
                    "$ref": "#/$defs/province"
                },
                "tax_code_verified": {
                    "description": "Se il codice fiscale è stato verificato; altrimenti è quello dichiarato dal professionista, con il solo controllo formale.",
                    "type": "boolean"
                }
            },
            "required": [
                "type",
                "first_name",
                "last_name",
                "municipality",
                "province",
                "tax_code_verified"
            ],
            "additionalProperties": false
        },
        "member_applicant": {
            "description": "Lo studio candidato: denominazione e sede. L'id dell'aderente arriva solo con la scelta.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "member"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "municipality": {
                    "$ref": "#/$defs/name"
                },
                "province": {
                    "$ref": "#/$defs/province"
                }
            },
            "required": [
                "type",
                "name",
                "municipality",
                "province"
            ],
            "additionalProperties": false
        },
        "member": {
            "description": "La controparte aderente, lo studio scelto. Il sistema la rimanda identica a ogni revisione.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "member"
                },
                "member_id": {
                    "$ref": "#/$defs/uuid"
                },
                "tax_code": {
                    "type": "null"
                },
                "first_name": {
                    "type": "null"
                },
                "last_name": {
                    "type": "null"
                },
                "email": {
                    "type": "null"
                },
                "vat_number": {
                    "type": "null"
                },
                "municipality": {
                    "type": "null"
                },
                "province": {
                    "type": "null"
                }
            },
            "required": [
                "type",
                "member_id",
                "tax_code",
                "first_name",
                "last_name",
                "email",
                "vat_number",
                "municipality",
                "province"
            ],
            "additionalProperties": false
        }
    }
}
