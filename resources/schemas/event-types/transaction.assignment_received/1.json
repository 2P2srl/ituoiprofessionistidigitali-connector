{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ituoiprofessionistidigitali.it/contract/event-types/transaction.assignment_received/1.json",
    "title": "transaction.assignment_received v1",
    "description": "L'incarico pubblicato affidato a uno studio con la scelta: la transazione accettata e il committente, che da qui si fa conoscere. La manda solo il portale, al sistema dello studio scelto.",
    "type": "object",
    "properties": {
        "transaction": {
            "description": "La transazione accettata, nella forma di GET /transactions, con lo studio destinatario come controparte. Il portale può aggiungere campi alla transazione senza cambiare versione.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "origin": {
                    "const": "platform"
                },
                "reference": {
                    "$ref": "#/$defs/reference"
                },
                "assignment_reference": {
                    "$ref": "#/$defs/reference"
                },
                "audience": {
                    "enum": [
                        "member",
                        "any"
                    ]
                },
                "principal": {
                    "$ref": "#/$defs/uuid"
                },
                "counterparty": {
                    "$ref": "#/$defs/member"
                },
                "typology": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                },
                "status": {
                    "const": "accepted"
                },
                "sent_at": {
                    "$ref": "#/$defs/datetime"
                },
                "expires_at": {
                    "$ref": "#/$defs/datetime"
                },
                "responded_at": {
                    "$ref": "#/$defs/datetime"
                },
                "signed_at": {
                    "type": "null"
                },
                "closed_at": {
                    "type": "null"
                },
                "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                },
                "total_cents": {
                    "type": "integer",
                    "minimum": 0
                },
                "revision": {
                    "type": "integer",
                    "minimum": 2
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "schema_version": {
                    "type": "integer",
                    "minimum": 1
                },
                "activities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                        "type": "object",
                        "required": [
                            "reference",
                            "compensation",
                            "estimated_minutes",
                            "minutes_worked",
                            "status",
                            "closed_at",
                            "total_cents",
                            "description"
                        ]
                    }
                },
                "updated_at": {
                    "$ref": "#/$defs/datetime"
                }
            },
            "required": [
                "id",
                "origin",
                "reference",
                "assignment_reference",
                "audience",
                "principal",
                "counterparty",
                "typology",
                "title",
                "description",
                "status",
                "sent_at",
                "expires_at",
                "responded_at",
                "signed_at",
                "closed_at",
                "currency",
                "total_cents",
                "revision",
                "type",
                "schema_version",
                "activities",
                "updated_at"
            ]
        },
        "principal": {
            "description": "Il committente, rivelato allo studio scelto.",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/uuid"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "municipality": {
                    "$ref": "#/$defs/name"
                },
                "province": {
                    "$ref": "#/$defs/province"
                }
            },
            "required": [
                "id",
                "name",
                "municipality",
                "province"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "transaction",
        "principal"
    ],
    "additionalProperties": false,
    "$defs": {
        "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "datetime": {
            "type": "string",
            "format": "date-time"
        },
        "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "province": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        },
        "member": {
            "description": "La controparte aderente, lo studio scelto. Il sistema la rimanda identica a ogni revisione.",
            "type": "object",
            "properties": {
                "type": {
                    "const": "member"
                },
                "member_id": {
                    "$ref": "#/$defs/uuid"
                },
                "tax_code": {
                    "type": "null"
                },
                "first_name": {
                    "type": "null"
                },
                "last_name": {
                    "type": "null"
                },
                "email": {
                    "type": "null"
                },
                "vat_number": {
                    "type": "null"
                },
                "municipality": {
                    "type": "null"
                },
                "province": {
                    "type": "null"
                }
            },
            "required": [
                "type",
                "member_id",
                "tax_code",
                "first_name",
                "last_name",
                "email",
                "vat_number",
                "municipality",
                "province"
            ],
            "additionalProperties": false
        }
    }
}
